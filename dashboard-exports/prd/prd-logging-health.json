        "connection": "Production Metrics Querier",
        "promqlExpression": "sum by(cluster) (max by (cluster,pod,plugin_id) (rate(fluentd_output_status_num_errors{cluster=~\"${cluster:regex}\",job=\"fluentd\",plugin_id=\"out_clickhouse\"}[5m])))",
        "numberFormat": {
