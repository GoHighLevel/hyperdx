        "source": "Production Metrics",
        "connection": "Production Metrics Querier",
        "promqlExpression": "topk(10,max by (cluster,pod,plugin_id) (fluentd_output_status_buffer_total_bytes{cluster=~\"${cluster:regex}\",job=\"fluentd\",plugin_id=\"out_clickhouse\"})) / 1073741824",
        "numberFormat": {
          "output": "number",
          "mantissa": 2,
          "thousandSeparated": true,
          "unit": "GiB"
        },
        "fillNulls": false,
