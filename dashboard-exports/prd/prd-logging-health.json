        "source": "Production Metrics",
        "connection": "Production Metrics Querier",
        "promqlExpression": "sum by(cluster) (max by (cluster,namespace,pod,container) (rate(container_cpu_usage_seconds_total{cluster=~\"${cluster:regex}\",job=\"cadvisor\",pod=~\"fluentd-.*\",container!=\"\",container!=\"POD\"}[5m])))",
