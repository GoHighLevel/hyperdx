        "displayType": "line",
        "source": "Production Metrics",
        "connection": "Production Metrics Querier",
        "promqlExpression": "sum by(cluster) (max by (cluster,namespace,pod,interface) (rate(container_network_transmit_bytes_total{cluster=~\"${cluster:regex}\",job=\"cadvisor\",pod=~\"fluentd-.*\"}[5m]))) / 1e6",
        "numberFormat": {
          "output": "number",
          "mantissa": 2,
          "thousandSeparated": true,
          "unit": "MB/s"
        },
        "fillNulls": false,
        "granularity": "1 minute",
        "seriesLimit": 30,
        "legendTemplate": "{{cluster}}"
      }
    },
