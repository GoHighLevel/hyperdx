        "configType": "promql",
        "displayType": "line",
        "source": "Production Metrics",
        "connection": "Production Metrics Querier",
        "promqlExpression": "count by(cluster) (count by(cluster,pod) (max by (cluster,pod,plugin_id) (fluentd_output_status_emit_records{cluster=~\"${cluster:regex}\",job=\"fluentd\",plugin_id=\"out_clickhouse\"})))",
