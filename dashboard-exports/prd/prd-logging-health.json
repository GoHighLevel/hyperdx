        "displayType": "line",
        "source": "Production Metrics",
        "connection": "Production Metrics Querier",
        "promqlExpression": "sum by(cluster) (max by (cluster,namespace,pod,container) (increase(kube_pod_container_status_restarts_total{cluster=~\"${cluster:regex}\",pod=~\"fluentd-.*\"}[15m])))",
