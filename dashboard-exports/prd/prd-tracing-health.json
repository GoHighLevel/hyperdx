{
  "version": "0.1.0",
  "name": "Tracing pipeline health — Production",
  "description": "**Trace pipeline health.** Rolling last hour; refresh every 30 seconds. Rates use 5m; failure counts use rolling 15m. Production collector job `otel-collector-traces` exports to `otlp/uptrace`. Debug output is excluded. These metrics do not establish that Uptrace spans are stored in HyperDX.\n\nAccepted = receiver accepted spans. Refused = receiver rejected spans. Sent = exporter reported success, not a guarantee of backend retention or queryability. Failed sends count span attempts and may recover through retries; they are not proven lost spans. Never subtract accepted from sent to claim loss: sampling, batching, multiple receivers/exporters and in-flight work affect counts.\n\nTrace queues are selected by data_type when available; legacy unlabelled queues are also included. Queue units are exporter-configured items/batches, not assumed spans. Cluster labels identify collectors, not each originating application. Receiver panels are independent of the exporter filter. Reporting counts describe observed collectors, not the desired population. Missing telemetry is not zero; backend storage, sampling and log-to-trace coverage are not fabricated. No alert rules are installed.",
  "tags": [
    "production",
    "observability-health",
    "tracing"
  ],
  "savedDateRange": {
    "type": "relative",
    "value": 3600
  },
  "savedRefreshInterval": 30,
  "savedFilterValues": [
    {
      "type": "variable",
      "name": "exporter",
      "values": [
        "otlp/uptrace"
      ]
    }
  ],
  "filters": [
    {
      "id": "cluster",
      "name": "Cluster",
      "variableName": "cluster",
      "type": "PROMETHEUS_LABEL",
      "source": "Production Metrics",
      "label": "cluster",
      "match": "otelcol_receiver_accepted_spans{job=\"otel-collector-traces\"}",
      "isBroadcastEnabled": false,
      "isVariableEnabled": true
    },
    {
      "id": "exporter",
      "name": "Trace exporter",
      "variableName": "exporter",
      "type": "PROMETHEUS_LABEL",
      "source": "Production Metrics",
      "label": "exporter",
      "match": "otelcol_exporter_sent_spans{cluster=~\"${cluster:regex}\",job=\"otel-collector-traces\",exporter!=\"debug\"}",
      "isBroadcastEnabled": false,
      "isVariableEnabled": true
    }
  ],
  "containers": [
    {
      "id": "overview",
      "title": "Health now",
      "collapsed": false
    },
    {
      "id": "trends",
      "title": "Throughput and pressure",
      "collapsed": false
    },
    {
      "id": "details",
      "title": "Troubleshooting",
      "collapsed": true
    }
  ],
  "tiles": [
    {
      "id": "reading-guide",
      "containerId": "details",
      "x": 0,
      "y": 0,
      "w": 24,
      "h": 7,
      "config": {
        "name": "How to read this dashboard",
        "displayType": "markdown",
        "source": "",
        "select": [],
        "where": "",
        "whereLanguage": "sql",
        "markdown": "**Trace pipeline health.** Rolling last hour; refresh every 30 seconds. Rates use 5m; failure counts use rolling 15m. Production collector job `otel-collector-traces` exports to `otlp/uptrace`. Debug output is excluded. These metrics do not establish that Uptrace spans are stored in HyperDX.\n\nAccepted = receiver accepted spans. Refused = receiver rejected spans. Sent = exporter reported success, not a guarantee of backend retention or queryability. Failed sends count span attempts and may recover through retries; they are not proven lost spans. Never subtract accepted from sent to claim loss: sampling, batching, multiple receivers/exporters and in-flight work affect counts.\n\nTrace queues are selected by data_type when available; legacy unlabelled queues are also included. Queue units are exporter-configured items/batches, not assumed spans. Cluster labels identify collectors, not each originating application. Receiver panels are independent of the exporter filter. Reporting counts describe observed collectors, not the desired population. Missing telemetry is not zero; backend storage, sampling and log-to-trace coverage are not fabricated. No alert rules are installed."
      }
    },
    {
      "id": "accepted",
      "containerId": "overview",
      "x": 0,
      "y": 0,
      "w": 4,
      "h": 6,
      "config": {
        "name": "Receiver-accepted spans",
        "configType": "promql",
        "displayType": "number",
        "source": "Production Metrics",
        "connection": "Production Metrics Querier",
        "promqlExpression": "last_over_time((sum (max by (cluster,service_instance_id,receiver,transport) (rate(otelcol_receiver_accepted_spans{cluster=~\"${cluster:regex}\",job=\"otel-collector-traces\"}[5m]))))[30s:30s] @ end())",
        "numberFormat": {
          "output": "number",
          "mantissa": 2,
          "thousandSeparated": true,
          "unit": "spans/s"
        },
        "fillNulls": false,
        "color": "chart-cyan"
      }
    },
    {
      "id": "sent",
      "containerId": "overview",
      "x": 4,
      "y": 0,
      "w": 4,
      "h": 6,
      "config": {
        "name": "Exporter-sent spans",
        "configType": "promql",
        "displayType": "number",
        "source": "Production Metrics",
        "connection": "Production Metrics Querier",
        "promqlExpression": "last_over_time((sum (max by (cluster,service_instance_id,exporter) (rate(otelcol_exporter_sent_spans{cluster=~\"${cluster:regex}\",job=\"otel-collector-traces\",exporter=~\"${exporter:regex}\",exporter!=\"debug\"}[5m]))))[30s:30s] @ end())",
        "numberFormat": {
          "output": "number",
          "mantissa": 2,
          "thousandSeparated": true,
          "unit": "spans/s"
        },
        "fillNulls": false,
        "color": "chart-cyan"
      }
    },
    {
      "id": "refused",
      "containerId": "overview",
      "x": 8,
      "y": 0,
      "w": 4,
      "h": 6,
      "config": {
        "name": "Refused spans · last 15m",
        "configType": "promql",
        "displayType": "number",
        "source": "Production Metrics",
        "connection": "Production Metrics Querier",
        "promqlExpression": "last_over_time((sum (max by (cluster,service_instance_id,receiver,transport) (increase(otelcol_receiver_refused_spans{cluster=~\"${cluster:regex}\",job=\"otel-collector-traces\"}[15m]))))[30s:30s] @ end())",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true,
          "unit": ""
        },
        "fillNulls": false,
        "color": "chart-gray",
        "colorRules": [
          {
            "operator": "eq",
            "value": 0,
            "color": "chart-success"
          },
          {
            "operator": "gt",
            "value": 0,
            "color": "chart-error"
          }
        ]
      }
    },
    {
      "id": "failed",
      "containerId": "overview",
      "x": 12,
      "y": 0,
      "w": 4,
      "h": 6,
      "config": {
        "name": "Failed span sends · last 15m",
        "configType": "promql",
        "displayType": "number",
        "source": "Production Metrics",
        "connection": "Production Metrics Querier",
        "promqlExpression": "last_over_time((sum (max by (cluster,service_instance_id,exporter) (increase(otelcol_exporter_send_failed_spans{cluster=~\"${cluster:regex}\",job=\"otel-collector-traces\",exporter=~\"${exporter:regex}\",exporter!=\"debug\"}[15m]))))[30s:30s] @ end())",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true,
          "unit": ""
        },
        "fillNulls": false,
        "color": "chart-gray",
        "colorRules": [
          {
            "operator": "eq",
            "value": 0,
            "color": "chart-success"
          },
          {
            "operator": "gt",
            "value": 0,
            "color": "chart-error"
          }
        ]
      }
    },
    {
      "id": "queue-use",
      "containerId": "overview",
      "x": 16,
      "y": 0,
      "w": 4,
      "h": 6,
      "config": {
        "name": "Highest trace queue usage",
        "configType": "promql",
        "displayType": "number",
        "source": "Production Metrics",
        "connection": "Production Metrics Querier",
        "promqlExpression": "last_over_time((max (100 * max by (cluster,service_instance_id,exporter) (otelcol_exporter_queue_size{cluster=~\"${cluster:regex}\",job=\"otel-collector-traces\",exporter=~\"${exporter:regex}\",exporter!=\"debug\",data_type=~\"traces|\"}) / (max by (cluster,service_instance_id,exporter) (otelcol_exporter_queue_capacity{cluster=~\"${cluster:regex}\",job=\"otel-collector-traces\",exporter=~\"${exporter:regex}\",exporter!=\"debug\",data_type=~\"traces|\"}) > 0)))[30s:30s] @ end())",
        "numberFormat": {
          "output": "number",
          "mantissa": 2,
          "thousandSeparated": true,
          "unit": "%"
        },
        "fillNulls": false,
        "color": "chart-gray",
        "colorRules": [
          {
            "operator": "gte",
            "value": 0,
            "color": "chart-success"
          },
          {
            "operator": "gte",
            "value": 70,
            "color": "chart-warning"
          },
          {
            "operator": "gte",
            "value": 90,
            "color": "chart-error"
          }
        ]
      }
    },
    {
      "id": "collectors",
      "containerId": "overview",
      "x": 20,
      "y": 0,
      "w": 4,
      "h": 6,
      "config": {
        "name": "Reporting trace collectors",
        "configType": "promql",
        "displayType": "number",
        "source": "Production Metrics",
        "connection": "Production Metrics Querier",
        "promqlExpression": "last_over_time((count (count by(cluster,service_instance_id) (max by (cluster,service_instance_id,receiver,transport) (otelcol_receiver_accepted_spans{cluster=~\"${cluster:regex}\",job=\"otel-collector-traces\"}))))[30s:30s] @ end())",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true,
          "unit": ""
        },
        "fillNulls": false,
        "color": "chart-cyan"
      }
    },
    {
      "id": "accepted-trend",
      "containerId": "trends",
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 8,
      "config": {
        "name": "Accepted spans by receiver",
        "configType": "promql",
        "displayType": "line",
        "source": "Production Metrics",
        "connection": "Production Metrics Querier",
        "promqlExpression": "sum by(cluster,receiver,transport) (max by (cluster,service_instance_id,receiver,transport) (rate(otelcol_receiver_accepted_spans{cluster=~\"${cluster:regex}\",job=\"otel-collector-traces\"}[5m])))",
        "numberFormat": {
          "output": "number",
          "mantissa": 2,
          "thousandSeparated": true,
          "unit": "spans/s"
