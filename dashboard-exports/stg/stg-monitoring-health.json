        "promqlExpression": "sum by(cluster) (max by (cluster,instance,exported_type) (rate(vm_rows_inserted_total{cluster=~\"${cluster:regex}\",app=~\"vminsert\"}[5m])))",
        "numberFormat": {
          "output": "number",
          "mantissa": 2,
          "thousandSeparated": true,
          "unit": "samples/s"
        },
        "fillNulls": false,
        "granularity": "1 minute",
        "seriesLimit": 30,
        "legendTemplate": "{{cluster}}"
      }
    },
